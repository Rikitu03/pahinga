---
import OnboardingLayout from '../layouts/OnboardingLayout.astro';
import OnboardingLogo from '../components/OnboardingLogo.astro';
import OnboardingForm from '../components/OnboardingForm.astro';
---

<OnboardingLayout title="Pahinga Onboarding">
  <!-- Living Animated Background Mesh Aura (Behind Card) -->
  <div id="ambient-mesh" class="ambient-mesh-container" aria-hidden="true">
    <div class="ambient-mesh-inner">
      <div class="mesh-orb mesh-orb-1"></div>
      <div class="mesh-orb mesh-orb-2"></div>
      <div class="mesh-orb mesh-orb-3"></div>
      <div class="mesh-orb mesh-orb-4"></div>
    </div>
  </div>

  <!-- Main Card Floating Over Ambient Aura -->
  <div id="app"
       class="relative z-10 flex min-h-dvh sm:min-h-0 w-full max-w-[420px] flex-col justify-between overflow-hidden bg-white/95 sm:bg-white shadow-[0_22px_65px_-15px_rgba(15,118,110,0.2),0_10px_30px_-10px_rgba(45,212,191,0.15)] sm:my-auto sm:rounded-[2.5rem] sm:border sm:border-white/90 sm:ring-1 sm:ring-teal-900/5 transition-all duration-300">

    <!-- Scrollable container if viewport is very short -->
    <div class="relative z-10 flex w-full flex-1 flex-col justify-between overflow-y-auto overscroll-contain px-6 pt-[max(2rem,env(safe-area-inset-top))] pb-[max(1.75rem,env(safe-area-inset-bottom))]">

      <main class="enter flex w-full flex-col items-center">
        <OnboardingLogo />
        <OnboardingForm />
      </main>

    </div>
  </div>

  <script src="../scripts/onboarding.js"></script>
</OnboardingLayout>
