<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <title>Pahinga Redirect</title>
  <script is:inline>
    // Local-first client-side routing
    if (localStorage.getItem('pahinga_onboarded') === 'true') {
      window.location.replace('/chat');
    } else {
      window.location.replace('/onboarding');
    }
  </script>
</head>
<body class="bg-[#eef7f6]">
</body>
</html>
