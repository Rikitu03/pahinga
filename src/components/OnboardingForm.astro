---
---
<form id="onboarding-form" novalidate aria-label="Your details" class="mt-7 flex w-full flex-col gap-5 sm:gap-6">

  <!-- Name -->
  <div class="flex flex-col gap-[12px] w-full">
    <label for="name" class="field-label">Name</label>
    <input id="name" name="name" type="text" data-field="name" required
           autocomplete="name" autocapitalize="words" spellcheck="false" maxlength="80"
           placeholder="Jason Jay M. Recto..."
           aria-invalid="false" aria-describedby="name-error"
           class="field h-[52px] w-full" />
    <p id="name-error" class="field-error" aria-live="polite"></p>
  </div>

  <!-- Country + Age -->
  <div class="grid grid-cols-[1fr_5.5rem] sm:grid-cols-[1fr_6.5rem] items-start gap-x-3 w-full">
    <!-- Country -->
    <div class="flex flex-col gap-[8px] w-full">
      <label for="country" class="field-label">Country</label>
      <div class="relative w-full">
        <select id="country" name="country" data-field="country" required
                autocomplete="country"
                aria-invalid="false" aria-describedby="country-error"
                class="field h-[52px] w-full cursor-pointer appearance-none pr-10 invalid:text-gray-400 [&>option]:text-gray-900">
          <option value="" disabled selected hidden>Philippines...</option>
        </select>
        <svg viewBox="0 0 24 24" class="pointer-events-none absolute right-3.5 top-1/2 size-5 -translate-y-1/2 text-gray-400" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="m6 9 6 6 6-6"></path>
        </svg>
      </div>
      <p id="country-error" class="field-error" aria-live="polite"></p>
    </div>

    <!-- Age -->
    <div class="flex flex-col gap-[8px] w-full">
      <label for="age" class="field-label">Age</label>
      <input id="age" name="age" type="number" data-field="age" required
             inputmode="numeric" min="13" max="120" step="1" autocomplete="off"
             placeholder="18..."
             aria-invalid="false" aria-describedby="age-error"
             class="field h-[52px] w-full px-2 text-center [appearance:textfield] [&::-webkit-inner-spin-button]:appearance-none [&::-webkit-outer-spin-button]:appearance-none" />
      <p id="age-error" class="field-error" aria-live="polite"></p>
    </div>
  </div>

  <!-- Describe yourself -->
  <div class="flex flex-col gap-[8px] w-full">
    <label for="about" class="field-label">Describe yourself</label>
    <div class="relative w-full">
      <textarea id="about" name="about" data-field="about" rows="4" maxlength="300"
                placeholder="say everything you want about yourself... your safe."
                aria-describedby="about-hint about-error"
                class="field min-h-[7.5rem] w-full resize-none py-3.5 pb-8 pr-16 leading-relaxed"></textarea>
      <p id="about-count" aria-hidden="true"
         class="pointer-events-none absolute bottom-2.5 right-4 text-xs font-semibold text-gray-400 data-[near=true]:text-amber-700">
        <span id="about-count-n"></span>/300
      </p>
    </div>
    <p id="about-hint" class="sr-only">Optional. Up to 300 characters. Press Control or Command plus Enter to continue.</p>
    <p id="about-error" class="field-error" aria-live="polite"></p>
  </div>

  <!-- CTA -->
  <div class="pt-1 w-full">
    <p id="form-error" role="alert" class="field-error mb-2 text-center"></p>
    <button id="cta" type="submit" disabled aria-describedby="cta-hint"
            class="h-[52px] w-full rounded-full bg-[#8abcb8] text-lg font-bold tracking-normal text-white transition-[background-color,transform,opacity] duration-200 hover:bg-[#78aca8] focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-teal-400/30 active:scale-[0.985] disabled:cursor-not-allowed disabled:bg-[#9cc8c5] disabled:opacity-80 disabled:active:scale-100 motion-reduce:transition-none">
      <span id="cta-label">continue...</span>
    </button>
    <p id="cta-hint" class="sr-only">Enter your name, country, and age to continue.</p>
  </div>
</form>
