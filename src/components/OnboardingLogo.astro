<div class="flex justify-center w-full">
  <h1 class="w-[72px] sm:w-20 flex-shrink-0">
    <svg viewBox="0 0 120 120" class="block w-full" role="img" aria-label="Pahinga">
      <defs>
        <linearGradient id="lg-sky" x1="0" y1="0" x2="1" y2="1">
          <stop offset="0" stop-color="#3fb4ee"></stop>
          <stop offset="1" stop-color="#5b66d8"></stop>
        </linearGradient>
        <linearGradient id="lg-wave" x1="0" y1="0" x2="1" y2="0">
          <stop offset="0" stop-color="#34c0aa"></stop>
          <stop offset="1" stop-color="#4fd69b"></stop>
        </linearGradient>
        <linearGradient id="lg-deep" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" stop-color="#1b8f93"></stop>
          <stop offset="1" stop-color="#115d6e"></stop>
        </linearGradient>
        <clipPath id="lg-clip">
          <path d="M18 78V52C18 28 36 10 60 10s42 18 42 42v26c0 20-18 34-42 34S18 98 18 78z"></path>
        </clipPath>
      </defs>
      <g clip-path="url(#lg-clip)">
        <rect width="120" height="120" fill="url(#lg-sky)"></rect>
        <path d="M46 78 74 36q5-6 10 0l26 42z" fill="#fff"></path>
        <path d="M34 72C32 48 48 34 66 38c-8 8-9 20-3 30-9-5-20-4-29 4z" fill="#2754b4"></path>
        <path d="M46 62c-1-10 5-18 14-20-5 6-5 13-1 20-4-2-9-2-13 0z" fill="#3b73d6"></path>
        <circle cx="92" cy="40" r="7" fill="#fff"></circle>
        <circle cx="100" cy="44" r="6" fill="#fff"></circle>
        <circle cx="84" cy="45" r="5" fill="#fff"></circle>
        <path d="M10 74c20-12 34 4 52 0s30-10 48-6v16c-18-4-30 4-48 6S30 80 10 88z" fill="url(#lg-wave)"></path>
        <path d="M10 88c20-8 34 4 52 2s30-10 48-6v6c-18-4-30 4-48 6S30 86 10 94z" fill="#fff"></path>
        <path d="M10 94c20-8 34 4 52 2s30-10 48-6v40H10z" fill="url(#lg-deep)"></path>
      </g>
    </svg>
  </h1>
</div>
