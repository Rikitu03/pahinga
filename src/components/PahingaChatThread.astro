---
---

<div id="thread" role="log" aria-live="off" aria-relevant="additions" aria-label="Conversation"
     class="flex flex-col gap-4 px-4 sm:px-6 pb-6 w-full max-w-3xl mx-auto"></div>

<!-- ===== Message templates ===== -->
<template id="tpl-ai">
  <article class="msg-in flex justify-start w-full">
    <div class="max-w-[92%] sm:max-w-[85%] md:max-w-2xl rounded-[1.75rem] bg-white/85 px-5 pb-2.5 pt-4 shadow-bubble ring-1 ring-white/80 backdrop-blur-sm">
      <p class="text-[1.02rem] sm:text-base leading-[1.6] text-teal-950"><span class="sr-only">Pahinga: </span><span class="msg-text"></span></p>
      <div class="mt-2 flex flex-wrap items-center justify-between gap-2 pt-1 border-t border-teal-50/80">
        <button type="button" data-speaking="false"
                class="voice-btn group/voice -ml-2 inline-flex min-h-8 w-fit shrink-0 items-center gap-1.5 whitespace-nowrap rounded-full px-2.5 py-1 text-[0.875rem] font-medium text-teal-800 transition-colors hover:bg-teal-50 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-teal-500 data-[speaking=true]:bg-teal-50">
          <svg viewBox="0 0 24 24" class="size-3.5 shrink-0 group-data-[speaking=true]/voice:hidden" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
            <path d="M4 9v6M8 5v14M12 8v8M16 4v16M20 9v6"></path>
          </svg>
          <svg viewBox="0 0 24 24" class="hidden size-3.5 shrink-0 group-data-[speaking=true]/voice:block" fill="currentColor" aria-hidden="true">
            <rect x="6" y="6" width="12" height="12" rx="2.5"></rect>
          </svg>
          <span class="voice-label whitespace-nowrap">Hear voice</span>
        </button>
        <span class="ai-meta hidden whitespace-nowrap text-[0.68rem] tracking-wide font-medium text-teal-700/80 bg-teal-50/90 ring-1 ring-teal-600/15 px-2.5 py-0.5 rounded-full select-none shrink-0"></span>
      </div>
    </div>
  </article>
</template>

<template id="tpl-user">
  <article class="msg-in flex justify-end w-full">
    <div class="max-w-[88%] sm:max-w-[82%] md:max-w-xl rounded-[1.75rem] bg-white/95 px-5 py-4 shadow-bubble ring-1 ring-white/80">
      <p class="text-[1.02rem] sm:text-base leading-[1.6] text-teal-950 font-medium"><span class="sr-only">You: </span><span class="msg-text whitespace-pre-wrap break-words"></span></p>
    </div>
  </article>
</template>

<template id="tpl-typing">
  <article class="msg-in flex justify-start w-full">
    <div class="flex items-center gap-1.5 rounded-[1.75rem] bg-white/85 px-5 py-4 shadow-bubble ring-1 ring-white/80 backdrop-blur-sm">
      <span class="sr-only">Pahinga is typing</span>
      <span class="size-2 animate-pulse rounded-full bg-teal-500 motion-reduce:animate-none" aria-hidden="true"></span>
      <span class="size-2 animate-pulse rounded-full bg-teal-500 [animation-delay:200ms] motion-reduce:animate-none" aria-hidden="true"></span>
      <span class="size-2 animate-pulse rounded-full bg-teal-500 [animation-delay:400ms] motion-reduce:animate-none" aria-hidden="true"></span>
    </div>
  </article>
</template>
