---
import '../styles/onboarding.css';
import { Agentation } from 'agentation';

interface Props {
  title?: string;
}

const { title = 'Pahinga' } = Astro.props;
---

<!DOCTYPE html>
<html lang="en" class="h-full bg-[#f0f8f7]">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <meta name="theme-color" content="#ffffff" />
  <title>{title}</title>

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Figtree:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

  <!-- Tailwind Play CDN (pinned) -->
  <script is:inline src="https://cdn.tailwindcss.com/3.4.17"></script>
  <script is:inline>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            sans: ['Figtree', 'ui-sans-serif', 'system-ui', '-apple-system', 'Segoe UI', 'Roboto', 'sans-serif'],
          },
        },
      },
    };
  </script>
</head>

<body class="relative flex min-h-dvh items-center justify-center overflow-x-hidden bg-[#eef7f5] font-sans text-gray-900 antialiased [-webkit-tap-highlight-color:transparent] p-0 sm:p-4 md:p-6">
  <slot />
  {import.meta.env.DEV && <Agentation client:only="react" />}
</body>
</html>
